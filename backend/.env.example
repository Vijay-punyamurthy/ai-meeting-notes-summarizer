# Server
PORT=4000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=meeting_notes

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=meeting_notes

# LLM (OpenAI-compatible client; works with OpenAI, Groq, or any compatible endpoint)
# Verified working setup uses Groq's free tier:
#   1. Get a key at https://console.groq.com -> API Keys
#   2. Set OPENAI_BASE_URL to Groq's OpenAI-compatible endpoint
#   3. Use a model your key actually has access to (check via GET
#      https://api.groq.com/openai/v1/models with an Authorization: Bearer <key> header,
#      since available models vary by account)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
